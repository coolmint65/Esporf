# BetsAPI - Primary odds data source ($10/mo at betsapi.com)
BETSAPI_TOKEN=your_betsapi_token_here

# Optional: Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Edge detection thresholds
MIN_EDGE_PERCENT=3.0
MIN_ODDS_DIFFERENCE=0.10
CLV_LOOKBACK_HOURS=4

# Polling interval in seconds
POLL_INTERVAL=120

# Leagues to track (comma-separated BetsAPI league IDs)
# 23114 = GT Leagues 12min, 37298 = GG League 8min, 38439 = Volta 6min
LEAGUE_IDS=23114,37298,38439
