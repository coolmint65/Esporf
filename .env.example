# BetsAPI - Primary data source for match results ($10/mo at betsapi.com)
BETSAPI_TOKEN=your_betsapi_token_here

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ROLE_ID=

# Display timezone (e.g. "US/Eastern", "UTC")
TIMEZONE=US/Eastern

# Leagues to track (comma-separated BetsAPI league IDs)
# 42648 = Esoccer Battle 8min (2025), 42649 = GT Leagues 12min (2025), 38439 = Volta 6min
LEAGUE_IDS=42648,42649,38439

# Polling interval in seconds (3 min — GG/GT matches are longer than Volta)
POLL_INTERVAL=180

# How far ahead to look for matches (seconds). 30 min = 1800
SCHEDULE_LOOKAHEAD=1800

# Trend detection thresholds
MIN_HIT_RATE=0.75
MIN_SAMPLE_SIZE=12
LAST_N_MATCHES=20

# Over/under goal lines to check (comma-separated)
GOAL_LINES=2.5,3.5,4.5,5.5,6.5,7.5

# Realistic lines the sportsbook actually offers for Volta
VOLTA_BOOK_LINES=2.5,3.5,4.5

# How many pages of historical results to fetch on first run (per league)
BACKFILL_PAGES=10

# Data persistence
DATA_DIR=data
DB_PATH=data/esporf.db
