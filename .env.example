# BetsAPI - Primary data source for match results ($10/mo at betsapi.com)
BETSAPI_TOKEN=your_betsapi_token_here

# Optional: Discord webhook for trend alerts
DISCORD_WEBHOOK_URL=

# Optional: Telegram bot for trend alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trend detection thresholds
MIN_HIT_RATE=0.70
MIN_SAMPLE_SIZE=10
LAST_N_MATCHES=20

# Over/under goal lines to check (comma-separated)
GOAL_LINES=2.5,3.5,4.5,5.5,6.5,7.5

# Polling interval in seconds
POLL_INTERVAL=120

# Leagues to track (comma-separated BetsAPI league IDs)
# 23114 = GT Leagues 12min, 37298 = GG League 8min, 38439 = Volta 6min
LEAGUE_IDS=23114,37298,38439

# How many pages of historical results to fetch on first run (per league)
BACKFILL_PAGES=10
